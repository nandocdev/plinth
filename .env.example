APP_NAME=Plinth
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=plinth_central
DB_USERNAME=postgres
DB_PASSWORD=

TENANCY_DB_HOST=127.0.0.1
TENANCY_DB_PORT=5432
TENANCY_DB_DATABASE=postgres
TENANCY_DB_USERNAME=postgres
TENANCY_DB_PASSWORD=
DB_TENANT_PREFIX=tenant_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default
SESSION_STORE=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PATH=horizon
PULSE_PATH=pulse
PULSE_ENABLED=true
PULSE_STORAGE_DRIVER=database
PULSE_DB_CONNECTION=central
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=default
PULSE_CACHE_DRIVER=redis

PENNANT_STORE=database
PENNANT_DATABASE_CONNECTION=central

PERMISSION_CACHE_STORE=redis

MEDIA_DISK=tenant
MEDIA_QUEUE_CONNECTION=redis
MEDIA_QUEUE=media

BACKUP_DB_CONNECTION=central
BACKUP_DISK=local
BACKUP_NOTIFICATIONS_EMAIL=

ACTIVITYLOG_CLEAN_AFTER_DAYS=180
ACTIVITYLOG_DEFAULT_LOG_NAME=platform

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
